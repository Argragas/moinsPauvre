SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Compte pour lequel on scrape (UUID auth.users)
SCRAPE_USER_ID=your-user-uuid

# Identifiants des sites (selon login requis)
IGRAAL_EMAIL=
IGRAAL_PASSWORD=
JOKO_EMAIL=
JOKO_PASSWORD=
UNEO_EMAIL=
UNEO_PASSWORD=
